units         metal
dimension     3
atom_style    atomic
atom_modify   map array
boundary      p  p  p

pair_style    mlip mlip.ini
read_data     in.dat 
pair_coeff    *  * 

neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes

timestep     0.0001

thermo_style custom step temp pe ke etotal press
thermo 10

minimize     0.0 1.0e-6 10000   100000

#velocity     all create 1000.0 10 dist uniform
#fix          1nvt all nvt temp 600.0  600.0  $(100.0*dt)
#run          2000
#unfix        1nvt

### relax box ###
#fix 1 all box/relax iso 0.0 vmax 0.001
minimize     0.0 1.0e-6 10000   100000

run          0
print        etotal=$(pe+ke)
#write_data   out.dat
